{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Spring (Boot, Security, Data...) w jednym PR",
      "matchPackageNames": ["/^org\\.springframework/"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "spring"
    },
    {
      "description": "Drobne aktualizacje frontendu w jednym PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend (minor/patch)"
    },
    {
      "description": "Duże wersje dopiero po zatwierdzeniu w Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
